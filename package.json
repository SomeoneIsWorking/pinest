{
  "name": "pinest",
  "version": "0.1.0",
  "description": "Remote control for pi coding agents",
  "type": "module",
  "main": "server/src/index.ts",
  "pi": {
    "extensions": [
      "./server/src/index.ts"
    ]
  },
  "scripts": {
    "start": "pi -e server/src/index.ts",
    "test": "npm run test:structure && RC_FIREBASE_API_KEY=\"${RC_FIREBASE_API_KEY:-test-api-key}\" node --test \"server/test/*.test.ts\"",
    "test:structure": "python3 -m unittest discover -s tools -p \"test_*.py\" && python3 tools/check_structure.py",
    "typecheck": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "typebox": "^1.3.19",
    "ws": "^8.21.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
