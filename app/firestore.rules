rules_version = '2';

// remote-code Firestore rules — hosted discovery backend (pinest-app).
//
// Firebase holds auth + discovery ONLY: one tiny doc per user. Chat content
// never touches Firestore. The doc carries two things:
//   * presence: who is online, and the tunnel URL to reach them;
//   * WebRTC signaling: the host's offer and the app's answer, so a direct
//     connection needs no second service.
//
// The hosted machine authenticates as the user and writes its own doc. The
// Admin-SDK self-host path bypasses rules.
//
// Deploy once with: firebase deploy --only firestore:rules --project pinest-app

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasValidHttpsUrl(url) {
      return url == null || (url is string
        && url.size() <= 2048
        && url.matches(
          'https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(/[A-Za-z0-9._~!$&()*+,;=:@%/-]*)?'
        ));
    }

    // The maps are bounded so a compromised or buggy client cannot fill the
    // document, and the bound is deliberately ABOVE what the machine itself
    // uses: the machine's own writes use a service account and bypass these
    // rules, while every client write is checked against them. A cap set AT
    // the machine's own limit therefore fails the moment the two overlap
    // during a handover - measured live: eight lanes filled `clients`, and
    // every client write came back PERMISSION_DENIED while the machine went on
    // publishing as if nothing were wrong. Headroom is what keeps that
    // impossible; `MAX_LANES` in server/src/direct-transport.ts owns the real
    // limit, and the lease there keeps the maps far below this bound.
    function hasValidSignaling() {
      let data = request.resource.data;
      return (!data.keys().hasAny(['p2pOffers'])
          || (data.p2pOffers is map && data.p2pOffers.size() <= 16))
        && (!data.keys().hasAny(['p2pAnswers'])
          || (data.p2pAnswers is map && data.p2pAnswers.size() <= 16));
    }

    // The app's own report about itself: bounded, shape-checked, and carrying
    // no chat data. The machine reads it to see the browser's half of a direct
    // connection, which it cannot see from its own side.
    function hasValidClientReport() {
      let data = request.resource.data;
      return (!data.keys().hasAny(['clients'])
          || (data.clients is map && data.clients.size() <= 16))
        && (!data.keys().hasAny(['clientReload']) || data.clientReload is int);
    }

    function hasValidPresenceShape() {
      let data = request.resource.data;
      let now = request.time.toMillis();
      return data.keys().hasAll(['url', 'online', 'ts'])
        && data.keys().hasOnly(
          ['url', 'online', 'ownerEmail', 'hostname', 'ts',
           'p2pOffers', 'p2pAnswers',
           'clients', 'clientReload'])
        && hasValidHttpsUrl(data.url)
        && data.online is bool
        && (!data.keys().hasAny(['ownerEmail'])
          || (data.ownerEmail is string
              && data.ownerEmail.size() >= 3
              && data.ownerEmail.size() <= 320
              && request.auth.token.email is string
              && data.ownerEmail == request.auth.token.email))
        && (!data.keys().hasAny(['hostname'])
          || (data.hostname is string
              && data.hostname.size() >= 1
              && data.hostname.size() <= 255))
        && data.ts is int
        && data.ts >= now - 120000
        && data.ts <= now + 120000
        && hasValidSignaling();
    }

    // A write that only touches signaling fields is judged as signaling: the
    // machine offers and the app answers without either having to re-assert the
    // presence freshness that the machine's heartbeat owns.
    function touchesOnlySignaling() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['p2pOffers', 'p2pAnswers'])
        && affected.hasAny(['p2pOffers', 'p2pAnswers']);
    }

    // The app's report and the machine's reload request are written on their
    // own, without re-asserting presence the machine's heartbeat owns. A write
    // that carries both would not match either branch, which is deliberate:
    // each field has one writer.
    function touchesOnlyClientReport() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['clients', 'clientReload'])
        && affected.hasAny(['clients', 'clientReload']);
    }

    // ── Discovery + signaling doc ─────────────────────────────────────────
    // The app reads it and writes its answer; the machine writes presence and
    // its offer. Both authenticate as the owner, and both are shape-checked.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && hasValidPresenceShape();
      allow update: if isOwner(uid)
        && hasValidSignaling()
        && hasValidClientReport()
        && (touchesOnlySignaling()
            || touchesOnlyClientReport()
            || (hasValidPresenceShape()
                && (!request.resource.data.keys().hasAny(['ownerEmail'])
                    || request.resource.data.ownerEmail == resource.data.ownerEmail)));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
